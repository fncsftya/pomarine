with "config/pomarine_tests_config.gpr";
with "pomarine.gpr";
with "pomarine_goldens.gpr";
with "pomarine_native.gpr";
with "pomarine_testing.gpr";
project Pomarine_Tests is

   for Source_Dirs use ("src/", "config/", "../examples/src/", "../examples/src/view_models/");
   for Object_Dir use "obj/" & Pomarine_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("golden.adb");

   package Compiler is
      --  Stack probes and canaries are for development and validation builds; a release build leaves them out.
      Stack_Checks := ("-fstack-check", "-fstack-protector-strong");
      case Pomarine_Tests_Config.Build_Profile is
         when "release" => Stack_Checks := ();
         when others => null;
      end case;

      for Default_Switches ("Ada") use
        Pomarine_Tests_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa")          --  validity checks everywhere
        & Stack_Checks;
   end Compiler;

   package Linker is
      --  The session keeps its items' text areas where it is declared:
      --  more than the usual 8 MB of the main thread's stack.
      for Default_Switches ("Ada") use ("-Wl,-stack_size,0x4000000");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Pomarine_Tests;
