with "config/pomarine_config.gpr";
with "pomarine_ui.gpr";
with "coretext.gpr";
with "sdl3.gpr";
with "texts.gpr";
with "typeset.gpr";
with "yoga.gpr";
project Pomarine is

   for Source_Dirs use ("config/");
   for Object_Dir use "obj/" & Pomarine_Config.Build_Profile;
   for Create_Missing_Dirs use "True";

   package Compiler is
      --  Stack probes and canaries are for development and validation builds; a release build leaves them out.
      Stack_Checks := ("-fstack-check", "-fstack-protector-strong");
      case Pomarine_Config.Build_Profile is
         when "release" => Stack_Checks := ();
         when others => null;
      end case;

      for Default_Switches ("Ada") use Pomarine_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa")          --  validity checks everywhere
        & Stack_Checks;
   end Compiler;

end Pomarine;
