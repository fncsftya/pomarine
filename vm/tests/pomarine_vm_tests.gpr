with "config/pomarine_vm_tests_config.gpr";
with "pomarine_vm.gpr";
project Pomarine_VM_Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Pomarine_VM_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("vm_tests.adb");

   package Compiler is
      --  Stack probes and canaries are for development and validation builds; a release build leaves them out.
      Stack_Checks := ("-fstack-check", "-fstack-protector-strong");
      case Pomarine_VM_Tests_Config.Build_Profile is
         when "release" => Stack_Checks := ();
         when others => null;
      end case;

      for Default_Switches ("Ada") use Pomarine_VM_Tests_Config.Ada_Compiler_Switches &
        ("-gnatwh", "-gnatyM120", "-gnatVa") & Stack_Checks;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Pomarine_VM_Tests;
