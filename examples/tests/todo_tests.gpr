with "pomarine_ui.gpr";
with "pomarine_vm.gpr";
with "pomarine_testing.gpr";
with "texts.gpr";
project Todo_Tests is
   for Source_Dirs use ("src", "../src", "../src/view_models");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("todo_vm_test.adb", "todo_view_test.adb", "ui_slice_test.adb", "ui_ownership_test.adb", "ui_sync_test.adb", "ui_text_test.adb", "ui_list_test.adb", "ui_reentry_test.adb", "ui_unchecked_test.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatyM120", "-gnatVa", "-gnatwa", "-gnatwh", "-g");
   end Compiler;
   package Linker is
      --  A tree holds the state of every widget it could have, so two of them are more than the usual 8 MB.
      for Default_Switches ("Ada") use ("-Wl,-stack_size,0x4000000");
   end Linker;
end Todo_Tests;
