with "config/examples_config.gpr";
with "pomarine.gpr";
with "pomarine_ui.gpr";
with "coretext.gpr";
with "sdl3.gpr";
with "texts.gpr";
with "typeset.gpr";
with "yoga.gpr";
project Examples is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Examples_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("hello_gui.adb", "todo_gui.adb");

   package Compiler is
      for Default_Switches ("Ada") use Examples_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa",          --  validity checks everywhere
         "-fstack-check",    --  detect stack overflow
         "-fstack-protector-strong");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Examples;
