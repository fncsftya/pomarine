with "config/examples_config.gpr";
with "pomarine.gpr";
with "pomarine_vm.gpr";
with "pomarine_ui.gpr";
with "coretext.gpr";
with "sdl3.gpr";
with "texts.gpr";
with "typeset.gpr";
with "yoga.gpr";
project Examples is

   for Source_Dirs use ("src/", "src/view_models/", "config/");
   for Object_Dir use "obj/" & Examples_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("hello_gui.adb", "todo_gui.adb", "clock_gui.adb", "gallery_gui.adb");

   package Compiler is
      --  Stack probes and canaries are for development and validation builds; a release build leaves them out.
      Stack_Checks := ("-fstack-check", "-fstack-protector-strong");
      case Examples_Config.Build_Profile is
         when "release" => Stack_Checks := ();
         when others => null;
      end case;

      for Default_Switches ("Ada") use Examples_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa")          --  validity checks everywhere
        & Stack_Checks;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-dead_strip");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Examples;
