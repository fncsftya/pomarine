with "../config/pomarine_config.gpr";
with "../model/bundled_pomarine_model.gpr";
with "../vm/bundled_pomarine_vm.gpr";
with "../sdl3/bundled_sdl3.gpr";
with "../texts/bundled_texts.gpr";
with "../typeset/bundled_typeset.gpr";
with "../yoga/bundled_yoga.gpr";
project Bundled_Pomarine_UI is

   for Library_Name use "pomarine_ui_ada";
   for Library_Version use
     Project'Library_Name & ".so." & Pomarine_Config.Crate_Version;

   for Source_Dirs use ("src/**", "../config/", "../bundle_config/");
   for Object_Dir use "obj/" & Pomarine_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("POMARINE_UI_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  Stack probes and canaries are for development and validation builds; a release build leaves them out.
      Stack_Checks := ("-fstack-check", "-fstack-protector-strong");
      case Pomarine_Config.Build_Profile is
         when "release" => Stack_Checks := ();
         when others => null;
      end case;

      for Default_Switches ("Ada") use Pomarine_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa")          --  validity checks everywhere
        & Stack_Checks;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Bundled_Pomarine_UI;
